{%- comment -%}
----------------------------------------------------------------------------------------------------------------------
SK2 PRODUCT RAIL (SCOTKILT — pages.html PDP cross-sell sections)
----------------------------------------------------------------------------------------------------------------------
One section that covers pages.html's three cross-sell bands on the product page,
switched by the "Products from" setting:

* Collection        → "Similar products" (the product's own collection, minus itself)
* Recommendations   → "You may also like"
* Recently viewed   → "Recently viewed"

Recommendations and Recently viewed reuse Prestige's own <product-recommendations>
and <recently-viewed-products> elements, which re-fetch this section and swap in
the result, so the data comes from Shopify exactly as in the native sections —
only the cards are the pages.html ones (snippets/sk2-product-card.liquid).
{%- endcomment -%}

{{ 'sk2-home.css' | asset_url | stylesheet_tag }}
{{ 'sk2-product.css' | asset_url | stylesheet_tag }}
<script src="{{ 'sk2-product.js' | asset_url }}" defer></script>

{%- liquid
  assign source = section.settings.source
  assign count = section.settings.products_count
  assign rail_id = 'sk2-rail-' | append: section.id
-%}

{%- comment -%}
  Collection cards double as the fallback for the Recommendations source:
  Shopify returns no recommendations for products it has no data on yet (a new
  or unpublished catalogue), and the element deletes itself when it comes back
  empty — so "You may also like" would silently never appear.
{%- endcomment -%}
{%- capture collection_cards -%}
  {%- liquid
    assign source_collection = section.settings.collection | default: product.collections.first
    assign fetch_count = count | plus: 1
  -%}
  {%- for card_product in source_collection.products limit: fetch_count -%}
    {%- unless card_product.id == product.id -%}
      {%- render 'sk2-product-card', product: card_product -%}
    {%- endunless -%}
  {%- endfor -%}
{%- endcapture -%}

{%- capture product_cards -%}
  {%- case source -%}
    {%- when 'related' -%}
      {%- if recommendations.products_count > 0 -%}
        {%- for card_product in recommendations.products -%}
          {%- render 'sk2-product-card', product: card_product -%}
        {%- endfor -%}
      {%- else -%}
        {{ collection_cards }}
      {%- endif -%}

    {%- when 'recently_viewed' -%}
      {%- assign parsed_terms = search.terms | split: ' OR ' -%}
      {%- for parsed_term in parsed_terms -%}
        {%- assign parsed_id = parsed_term | split: 'id:' | last | times: 1 -%}
        {%- assign card_product = search.results | where: 'id', parsed_id | first -%}
        {%- if card_product != blank -%}
          {%- render 'sk2-product-card', product: card_product -%}
        {%- endif -%}
      {%- endfor -%}

    {%- else -%}
      {{ collection_cards }}
  {%- endcase -%}
{%- endcapture -%}

{%- capture section_body -%}
  <section class="sk2__section sk2__section--tight{% if section.settings.background == 'ivory2' %} sk2__section--ivory2{% endif %}" aria-labelledby="sk2-rail-title-{{ section.id }}">
    <div class="sk2__container">
      <div class="sk2__sec-head">
        <div>
          <h2 class="h3" id="sk2-rail-title-{{ section.id }}">{{ section.settings.heading | escape }}</h2>
          {%- if section.settings.subheading != blank -%}
            <p class="lede" style="font-size:15px">{{ section.settings.subheading | escape }}</p>
          {%- endif -%}
        </div>
        <div class="sk2__sec-head__tools">
          {%- if section.settings.link_text != blank -%}
            <a class="sk2__link" href="{{ section.settings.link_url | default: routes.all_products_collection_url }}">{{ section.settings.link_text | escape }}</a>
          {%- endif -%}
          {%- if section.settings.layout == 'rail' -%}
            <div class="sk2-rail-btns">
              <button type="button" class="sk2-rail-btn" data-sk2-rail-nav="{{ rail_id }}" data-sk2-dir="prev" aria-label="{{ 'general.accessibility.previous' | t | escape }}">{% render 'sk2-icons', icon: 'left' %}</button>
              <button type="button" class="sk2-rail-btn" data-sk2-rail-nav="{{ rail_id }}" data-sk2-dir="next" aria-label="{{ 'general.accessibility.next' | t | escape }}">{% render 'sk2-icons', icon: 'right' %}</button>
            </div>
          {%- endif -%}
        </div>
      </div>
      {%- if section.settings.layout == 'grid' -%}
        <div class="sk2-pgrid">{{ product_cards }}</div>
      {%- endif -%}
    </div>
    {%- if section.settings.layout == 'rail' -%}
      <div class="sk2-rail-wrap">
        <div class="sk2-rail" id="{{ rail_id }}">{{ product_cards }}</div>
      </div>
    {%- endif -%}
  </section>
{%- endcapture -%}

{%- case source -%}
  {%- when 'related' -%}
    <product-recommendations class="sk2" product="{{ product.id }}" limit="{{ count }}" intent="related">
      {%- if recommendations.performed and product_cards != blank -%}
        {{ section_body }}
      {%- endif -%}
    </product-recommendations>

  {%- when 'recently_viewed' -%}
    <recently-viewed-products class="sk2" products-count="{{ count }}" {% if request.page_type == 'product' %}exclude-id="{{ product.id }}"{% endif %}>
      {%- if search.performed and search.results_count > 0 -%}
        {{ section_body }}
      {%- endif -%}
    </recently-viewed-products>

  {%- else -%}
    {%- if product_cards != blank -%}
      <div class="sk2">{{ section_body }}</div>
    {%- endif -%}
{%- endcase -%}

{% schema %}
{
  "name": "Product rail (SK2)",
  "tag": "section",
  "settings": [
    {
      "type": "select",
      "id": "source",
      "label": "Products from",
      "default": "collection",
      "options": [
        {"value": "collection", "label": "Collection (similar products)"},
        {"value": "related", "label": "Recommendations (you may also like)"},
        {"value": "recently_viewed", "label": "Recently viewed"}
      ]
    },
    {"type": "collection", "id": "collection", "label": "Collection", "info": "Only for the \"Collection\" source. Leave empty to use the product's own first collection."},
    {"type": "range", "id": "products_count", "label": "Products", "min": 2, "max": 12, "step": 1, "default": 8},
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "default": "rail",
      "options": [
        {"value": "rail", "label": "Horizontal rail"},
        {"value": "grid", "label": "Grid"}
      ]
    },
    {
      "type": "select",
      "id": "background",
      "label": "Background",
      "default": "ivory",
      "options": [
        {"value": "ivory", "label": "Ivory"},
        {"value": "ivory2", "label": "Ivory (darker)"}
      ]
    },
    {"type": "header", "content": "Text"},
    {"type": "text", "id": "heading", "label": "Heading", "default": "Similar products"},
    {"type": "text", "id": "subheading", "label": "Subheading", "default": "More from the same collection."},
    {"type": "text", "id": "link_text", "label": "Link text", "default": "All kilts"},
    {"type": "url", "id": "link_url", "label": "Link URL"}
  ],
  "presets": [{"name": "Product rail (SK2)"}],
  "enabled_on": {"templates": ["product"]}
}
{% endschema %}
