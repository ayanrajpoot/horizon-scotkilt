{%- comment -%}
----------------------------------------------------------------------------------------------------------------------
SK2 COLLECTION (SCOTKILT — pages.html `CategoryPage()`)
----------------------------------------------------------------------------------------------------------------------
The collection page in the pages.html category design: breadcrumb, editorial
hero, sub-collection chips, sticky filter sidebar, toolbar, active filter
pills, product grid and "Load more".

FILTERING IS SHOPIFY'S OWN TAG FILTERING — no app needed. Shopify serves
/collections/<handle>/<tag>[+<tag>] natively, so every filter option here is a
plain link. Filter groups are blocks, so more can be added in the theme editor:

  · "Filter group (tags)" — either a tag prefix ("Colour" picks up every
    Colour:Blue, Colour:Green… tag in the collection) or an explicit tag list.
  · "Filter group (collections)" — links across to other collections.

Only tags that exist on products in this collection are shown, so a group
never renders empty.
{%- endcomment -%}

{{ 'sk2-home.css' | asset_url | stylesheet_tag }}
{{ 'sk2-collection.css' | asset_url | stylesheet_tag }}
{{ 'sk2-product.css' | asset_url | stylesheet_tag }}
{{ 'sk2-quick-view.css' | asset_url | stylesheet_tag }}
<script src="{{ 'sk2-home.js' | asset_url }}" defer></script>
{%- comment -%} Quick view reuses the product page's own markup, so it needs the PDP's css and its delegated behaviours. {%- endcomment -%}
<script src="{{ 'sk2-product.js' | asset_url }}" defer></script>
<script src="{{ 'sk2-quick-view.js' | asset_url }}" defer></script>
<script src="{{ 'sk2-collection.js' | asset_url }}" defer></script>

{%- liquid
  assign sort = collection.sort_by

  comment
    The tag path of the page we are on, reused by the sort select and by the
    section-rendering URL that "Load more" fetches.
  endcomment
  assign current_path = ''
  for current in current_tags
    assign current_handle = current | handleize
    assign current_path = current_path | append: current_handle | append: '+'
  endfor
  assign current_path = current_path | split: '+' | join: '+'

  assign base_url = collection.url
  if current_path != blank
    assign base_url = collection.url | append: '/' | append: current_path
  endif

  assign clear_url = collection.url
  if sort != blank
    assign clear_url = collection.url | append: '?sort_by=' | append: sort
  endif

  comment
    Which options are ticked is decided against the handleized tag path, the
    same string the option links are built from, so the tick can never
    disagree with the URL even if all_tags and current_tags differ in case.
  endcomment
  assign current_lookup = '+' | append: current_path | append: '+'


  comment
    A group is only worth a column if at least one of its options survives the
    "tag exists in this collection" test, so count them up front.
  endcomment
  assign filter_groups = 0
  for block in section.blocks
    case block.type
      when 'tag_group'
        if block.settings.tag_prefix != blank
          assign prefix = block.settings.tag_prefix | strip | downcase
          for tag in collection.all_tags
            assign parts = tag | split: ':'
            if parts.size > 1
              assign group_name = parts[0] | strip | downcase
              if group_name == prefix
                assign filter_groups = filter_groups | plus: 1
                break
              endif
            endif
          endfor
        elsif block.settings.tags != blank
          assign wanted_tags = block.settings.tags | split: ','
          for wanted in wanted_tags
            assign wanted_tag = wanted | strip
            if collection.all_tags contains wanted_tag
              assign filter_groups = filter_groups | plus: 1
              break
            endif
          endfor
        endif
      when 'collection_group'
        if block.settings.collections.count > 0
          assign filter_groups = filter_groups | plus: 1
        endif
    endcase
  endfor

  comment
    Shopify's own storefront filters (Search & Discovery) need no setup here:
    whatever the merchant turns on in the admin renders as another group in
    the same sidebar, next to the tag-group blocks.
  endcomment
  assign native_active = 0
  for filter in collection.filters
    if filter.type == 'price_range'
      if filter.range_max > 0
        assign filter_groups = filter_groups | plus: 1
        if filter.min_value.value or filter.max_value.value
          assign native_active = native_active | plus: 1
        endif
      endif
    else
      if filter.values.size > 0
        assign filter_groups = filter_groups | plus: 1
        assign native_active = native_active | plus: filter.active_values.size
      endif
    endif
  endfor

  assign active_count = current_tags.size | plus: native_active
-%}

{%- capture icon_chevron -%}<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg>{%- endcapture -%}
{%- capture icon_check -%}<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12l5 5L19 7"/></svg>{%- endcapture -%}
{%- capture icon_close -%}<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg>{%- endcapture -%}
{%- capture icon_menu -%}<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h16M7 12h10M10 17h4"/></svg>{%- endcapture -%}

<div class="sk2 sk2-cat" data-sk2-section="{{ section.id }}">
  <div class="sk2__container">

    {%- comment -%}------- breadcrumb -------{%- endcomment -%}
    <nav class="crumbs" aria-label="Breadcrumb">
      <a href="{{ routes.root_url }}">{{ 'general.breadcrumb.home' | t }}</a><span>/</span>
      {%- if section.settings.parent_title != blank -%}
        <a href="{{ section.settings.parent_url | default: routes.all_products_collection_url }}">{{ section.settings.parent_title | escape }}</a><span>/</span>
      {%- endif -%}
      <span aria-current="page">{{ collection.title | escape }}</span>
    </nav>

    {%- comment -%}------- hero -------{%- endcomment -%}
    <header class="cat-hero">
      <div>
        {%- assign eyebrow = collection.metafields.custom.eyebrow.value | default: section.settings.eyebrow -%}
        {%- if eyebrow != blank -%}<p class="cat-hero__eyebrow">{{ eyebrow | escape }}</p>{%- endif -%}
        <h1>{{ collection.title | escape }}</h1>
        {%- if collection.description != blank -%}
          <div class="lede">{{ collection.description }}</div>
        {%- elsif section.settings.intro != blank -%}
          <div class="lede">{{ section.settings.intro }}</div>
        {%- endif -%}

        <div class="cat-hero__facts">
          {%- if section.settings.show_count_fact -%}
            <div><strong>{{ collection.all_products_count }}</strong>{{ section.settings.count_fact_label | escape }}</div>
          {%- endif -%}
          {%- for block in section.blocks -%}
            {%- if block.type == 'fact' -%}
              <div {{ block.shopify_attributes }}><strong>{{ block.settings.value | escape }}</strong>{{ block.settings.label | escape }}</div>
            {%- endif -%}
          {%- endfor -%}
        </div>
      </div>

      <div class="cat-hero__visual">
        {%- render 'sk2-visual',
          image: collection.image,
          alt: collection.title,
          color_1: '#3d3a35', color_2: '#2b2925', color_3: '#171614',
          ratio: '4/3'
        -%}
        {%- if section.settings.image_caption != blank -%}
          <p class="cat-hero__cap">{{ section.settings.image_caption | escape }}</p>
        {%- endif -%}
      </div>
    </header>

    {%- comment -%}------- sub-collection chips -------{%- endcomment -%}
    {%- if section.settings.chips_menu != blank and section.settings.chips_menu.links.size > 0 -%}
      <div class="chips" aria-label="Browse within {{ collection.title | escape }}">
        {%- for link in section.settings.chips_menu.links -%}
          {%- assign chip_image = link.object.image -%}
          {%- if chip_image == blank -%}{%- assign chip_image = link.object.featured_image -%}{%- endif -%}
          {%- if chip_image != blank -%}
            <a class="chip" href="{{ link.url }}">
              {%- render 'sk2-visual',
                image: chip_image,
                alt: '',
                color_1: '#3d3a35', color_2: '#2b2925', color_3: '#171614',
                ratio: '1/1'
              -%}
              {{ link.title | escape }}
            </a>
          {%- else -%}
            <a class="chip chip--text" href="{{ link.url }}">{{ link.title | escape }}</a>
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- endif -%}

    {%- paginate collection.products by section.settings.products_per_page -%}
      <div class="cat-layout{% if filter_groups == 0 %} cat-layout--wide{% endif %}">

        {%- comment -%}------- filters -------{%- endcomment -%}
        {%- if filter_groups > 0 -%}
          <aside class="filters" id="sk2-filters-{{ section.id }}" aria-label="Filters">
            <div class="filters__head">
              <h2>Filter</h2>
              <div style="display:flex;gap:10px;align-items:center">
                {%- if active_count > 0 -%}
                  <a class="filters__clear" href="{{ clear_url }}">{{ 'collection.faceting.clear_filters' | t }}</a>
                {%- endif -%}
                <button type="button" class="filters__close" data-sk2-filters-close aria-label="Close filters">{{ icon_close }}</button>
              </div>
            </div>

            {%- comment -%}------- Shopify's own filters -------{%- endcomment -%}
            {%- for filter in collection.filters -%}
              {%- case filter.type -%}

                {%- when 'price_range' -%}
                  {%- liquid
                    comment
                      The mock offers price as four bands rather than a slider,
                      so the range is quartered and each band is a plain link --
                      no form, and it swaps like every other filter link.
                    endcomment
                    assign band_max = filter.range_max | divided_by: 100
                    assign band_step = band_max | divided_by: 4
                    assign price_join = '?'
                    if filter.url_to_remove contains '?'
                      assign price_join = '&'
                    endif
                    assign cur_lo = filter.min_value.value | default: 0
                    assign cur_hi = filter.max_value.value | default: filter.range_max
                  -%}
                  {%- if band_step > 0 -%}
                    <div class="fgroup is-open">
                      <button type="button" class="fgroup__btn" data-sk2-fgroup aria-expanded="true">
                        {{ filter.label | escape }}{{ icon_chevron }}
                      </button>
                      <div class="fgroup__panel"><div>
                        {%- for i in (1..4) -%}
                          {%- liquid
                            assign lo = i | minus: 1 | times: band_step
                            assign hi = i | times: band_step
                            if i == 4
                              assign hi = band_max
                            endif
                            assign lo_cents = lo | times: 100
                            assign hi_cents = hi | times: 100
                            assign is_on = false
                            if cur_lo == lo_cents and cur_hi == hi_cents
                              assign is_on = true
                            endif

                            capture band_url
                              echo filter.url_to_remove
                              unless is_on
                                echo price_join
                                if lo > 0
                                  echo filter.min_value.param_name
                                  echo '='
                                  echo lo
                                endif
                                if i < 4
                                  if lo > 0
                                    echo '&'
                                  endif
                                  echo filter.max_value.param_name
                                  echo '='
                                  echo hi
                                endif
                              endunless
                            endcapture
                          -%}
                          <a class="fopt2{% if is_on %} is-on{% endif %}" href="{{ band_url }}" rel="nofollow"{% if is_on %} aria-current="true"{% endif %}>
                            <span class="fopt2__box">{{ icon_check }}</span>
                            {%- if i == 1 -%}
                              Under {{ hi_cents | money }}
                            {%- elsif i == 4 -%}
                              {{ lo_cents | money }} and up
                            {%- else -%}
                              {{ lo_cents | money }} &ndash; {{ hi_cents | money }}
                            {%- endif -%}
                          </a>
                        {%- endfor -%}
                      </div></div>
                    </div>
                  {%- endif -%}

                {%- else -%}
                  {%- if filter.values.size > 0 -%}
                    <div class="fgroup is-open">
                      <button type="button" class="fgroup__btn" data-sk2-fgroup aria-expanded="true">
                        {{ filter.label | escape }}{{ icon_chevron }}
                      </button>
                      <div class="fgroup__panel"><div>
                        {%- for value in filter.values -%}
                          {%- unless value.count == 0 and value.active == false -%}
                            <a class="fopt2{% if value.active %} is-on{% endif %}" href="{% if value.active %}{{ value.url_to_remove }}{% else %}{{ value.url_to_add }}{% endif %}" rel="nofollow"{% if value.active %} aria-current="true"{% endif %}>
                              <span class="fopt2__box">{{ icon_check }}</span>
                              {%- if value.swatch.color -%}
                                <span class="fopt2__dot" style="background:{{ value.swatch.color }}"></span>
                              {%- endif -%}
                              {{ value.label | escape }}
                              <small>{{ value.count }}</small>
                            </a>
                          {%- endunless -%}
                        {%- endfor -%}
                      </div></div>
                    </div>
                  {%- endif -%}

              {%- endcase -%}
            {%- endfor -%}

            {%- for block in section.blocks -%}
              {%- case block.type -%}

                {%- when 'tag_group' -%}
                  {%- liquid
                    comment
                      Collect this group's tags — either every tag carrying the
                      block's prefix, or the explicit list, keeping only tags
                      that actually exist in this collection.
                    endcomment
                    assign group_tags = ''
                    assign group_labels = ''

                    if block.settings.tag_prefix != blank
                      assign prefix = block.settings.tag_prefix | strip | downcase
                      for tag in collection.all_tags
                        assign parts = tag | split: ':'
                        if parts.size > 1
                          assign group_name = parts[0] | strip | downcase
                          if group_name == prefix
                            assign value = parts[1] | strip
                            assign group_tags = group_tags | append: tag | append: '~|~'
                            assign group_labels = group_labels | append: value | append: '~|~'
                          endif
                        endif
                      endfor
                    elsif block.settings.tags != blank
                      assign wanted_tags = block.settings.tags | split: ','
                      for wanted in wanted_tags
                        assign wanted_tag = wanted | strip
                        if collection.all_tags contains wanted_tag
                          assign group_tags = group_tags | append: wanted_tag | append: '~|~'
                          assign group_labels = group_labels | append: wanted_tag | append: '~|~'
                        endif
                      endfor
                    endif

                    assign group_tags = group_tags | split: '~|~'
                    assign group_labels = group_labels | split: '~|~'
                    assign swatch_lines = block.settings.swatch_colors | newline_to_br | split: '<br />'
                  -%}

                  {%- if group_tags.size > 0 -%}
                    <div class="fgroup{% if block.settings.open %} is-open{% endif %}" {{ block.shopify_attributes }}>
                      <button type="button" class="fgroup__btn" data-sk2-fgroup aria-expanded="{{ block.settings.open }}">
                        {{ block.settings.heading | escape }}{{ icon_chevron }}
                      </button>
                      <div class="fgroup__panel"><div>
                        {%- if block.settings.style == 'grid' -%}
                          <div class="fsizes">
                            {%- for tag in group_tags -%}
                              {%- assign target_key = tag | handleize | prepend: '+' | append: '+' -%}
                              {%- assign is_on = false -%}
                              {%- if current_lookup contains target_key -%}{%- assign is_on = true -%}{%- endif -%}
                              {%- capture option_url -%}{%- render 'sk2-tag-url', collection: collection, tag: tag, sort: sort -%}{%- endcapture -%}
                              <a class="fsize{% if is_on %} is-on{% endif %}" href="{{ option_url }}" rel="nofollow"{% if is_on %} aria-current="true"{% endif %}>
                                {{- group_labels[forloop.index0] | escape -}}
                              </a>
                            {%- endfor -%}
                          </div>
                        {%- else -%}
                          {%- for tag in group_tags -%}
                            {%- liquid
                              assign target_key = tag | handleize | prepend: '+' | append: '+'
                              assign is_on = false
                              if current_lookup contains target_key
                                assign is_on = true
                              endif
                              assign label = group_labels[forloop.index0]

                              assign swatch = ''
                              if block.settings.style == 'swatch'
                                assign label_key = label | downcase | strip
                                for line in swatch_lines
                                  assign pair = line | strip_newlines | strip | split: '='
                                  if pair.size > 1
                                    assign pair_key = pair[0] | downcase | strip
                                    if pair_key == label_key
                                      assign swatch = pair[1] | strip
                                    endif
                                  endif
                                endfor
                                if swatch == blank
                                  assign swatch = label | handleize
                                endif
                              endif
                            -%}
                            {%- capture option_url -%}{%- render 'sk2-tag-url', collection: collection, tag: tag, sort: sort -%}{%- endcapture -%}
                            <a class="fopt2{% if is_on %} is-on{% endif %}" href="{{ option_url }}" rel="nofollow"{% if is_on %} aria-current="true"{% endif %}>
                              <span class="fopt2__box">{{ icon_check }}</span>
                              {%- if swatch != blank -%}<span class="fopt2__dot" style="background:{{ swatch }}"></span>{%- endif -%}
                              {{ label | escape }}
                            </a>
                          {%- endfor -%}
                        {%- endif -%}
                      </div></div>
                    </div>
                  {%- endif -%}

                {%- when 'collection_group' -%}
                  {%- if block.settings.collections.count > 0 -%}
                    <div class="fgroup{% if block.settings.open %} is-open{% endif %}" {{ block.shopify_attributes }}>
                      <button type="button" class="fgroup__btn" data-sk2-fgroup aria-expanded="{{ block.settings.open }}">
                        {{ block.settings.heading | escape }}{{ icon_chevron }}
                      </button>
                      <div class="fgroup__panel"><div>
                        {%- for linked in block.settings.collections -%}
                          {%- assign is_on = false -%}
                          {%- if linked.handle == collection.handle -%}{%- assign is_on = true -%}{%- endif -%}
                          <a class="fopt2{% if is_on %} is-on{% endif %}" href="{% if is_on %}{{ clear_url }}{% else %}{{ linked.url }}{% endif %}"{% if is_on %} aria-current="true"{% endif %}>
                            <span class="fopt2__box">{{ icon_check }}</span>
                            {{ linked.title | escape }}
                            <small>{{ linked.all_products_count }}</small>
                          </a>
                        {%- endfor -%}
                      </div></div>
                    </div>
                  {%- endif -%}

              {%- endcase -%}
            {%- endfor -%}
          </aside>
        {%- endif -%}

        {%- comment -%}------- results -------{%- endcomment -%}
        <div>
          <div class="toolbar">
            <div class="toolbar__count">
              <strong>{{ paginate.items }}</strong> {% if paginate.items == 1 %}{{ section.settings.item_label_one | escape }}{% else %}{{ section.settings.item_label_other | escape }}{% endif %}
            </div>
            <div class="toolbar__right">
              {%- if filter_groups > 0 -%}
                <button type="button" class="filters-btn" data-sk2-filters-open="sk2-filters-{{ section.id }}">
                  {{ icon_menu }}{{ 'collection.faceting.filters' | t }} <b>{% if active_count > 0 %}{{ active_count }}{% endif %}</b>
                </button>
              {%- endif -%}
              {%- if section.settings.show_sort_by and collection.sort_options.size > 0 -%}
                {%- assign selected_sort = collection.sort_by | default: collection.default_sort_by -%}
                <label class="sort">
                  Sort
                  <select data-sk2-sort data-sk2-base="{{ base_url }}" aria-label="Sort">
                    {%- for option in collection.sort_options -%}
                      {%- if option.name != blank -%}
                        <option value="{{ option.value }}"{% if option.value == selected_sort %} selected{% endif %}>{{ option.name }}</option>
                      {%- endif -%}
                    {%- endfor -%}
                  </select>
                </label>
              {%- endif -%}
            </div>
          </div>

          <div class="active">
            {%- for tag in current_tags -%}
              {%- capture remove_url -%}{%- render 'sk2-tag-url', collection: collection, tag: tag, sort: sort -%}{%- endcapture -%}
              {%- assign parts = tag | split: ':' -%}
              {%- if parts.size > 1 -%}{%- assign label = parts[1] | strip -%}{%- else -%}{%- assign label = tag -%}{%- endif -%}
              <a href="{{ remove_url }}" rel="nofollow">{{ label | escape }}{{ icon_close }}</a>
            {%- endfor -%}
            {%- for filter in collection.filters -%}
              {%- if filter.type == 'price_range' -%}
                {%- if filter.min_value.value or filter.max_value.value -%}
                  <a href="{{ filter.url_to_remove }}" rel="nofollow">{{ filter.label | escape }}{{ icon_close }}</a>
                {%- endif -%}
              {%- else -%}
                {%- for value in filter.active_values -%}
                  <a href="{{ value.url_to_remove }}" rel="nofollow">{{ value.label | escape }}{{ icon_close }}</a>
                {%- endfor -%}
              {%- endif -%}
            {%- endfor -%}
          </div>

          <div class="cat-grid">
            {%- if collection.products.size == 0 -%}
              <div class="cat-empty">
                <strong>{{ 'collection.faceting.no_results' | t }}</strong>
                {%- if active_count > 0 -%}
                  Try removing a filter, or <a class="sk2__link" href="{{ clear_url }}">clear all</a>.
                {%- endif -%}
              </div>
            {%- else -%}
              <div class="sk2-pgrid" data-sk2-grid>
                {%- for product in collection.products -%}
                  {%- render 'sk2-product-card', product: product -%}
                {%- endfor -%}
              </div>

              {%- if paginate.pages > 1 -%}
                {%- comment -%}
                  Cumulative, so the text stays right after "Load more" has
                  appended a page: everything before this page, plus this page.
                {%- endcomment -%}
                {%- assign shown = paginate.current_offset | plus: collection.products.size -%}
                <div class="cat-more" data-sk2-more>
                  <span data-sk2-more-count>Showing {{ shown }} of {{ paginate.items }}</span>
                  <div class="cat-more__bar">
                    <i data-sk2-more-bar style="width:{{ shown | times: 100 | divided_by: paginate.items }}%"></i>
                  </div>
                  {%- if paginate.next.is_link -%}
                    <button type="button" class="btn btn--line" data-sk2-more-btn data-sk2-next="{{ paginate.next.url }}" data-sk2-section="{{ section.id }}">
                      {{- 'Load more' -}}
                    </button>
                  {%- endif -%}
                </div>
                {%- comment -%}PORT: Prestige's 'pagination' snippet -> Horizon's equivalent, same `paginate` param.{%- endcomment -%}
                {%- render 'pagination-controls', paginate: paginate -%}
              {%- endif -%}
            {%- endif -%}
          </div>
        </div>
      </div>
    {%- endpaginate -%}
  </div>

  <div class="sk2-cat__backdrop" data-sk2-filters-close hidden></div>
</div>

{%- render 'sk-section-style', sk_section: section -%}

{% schema %}
{
  "name": "SK2 Collection",
  "class": "shopify-section--sk2-collection",
  "tag": "section",
  "settings": [
    {
      "type": "header",
      "content": "Hero"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Shop",
      "info": "Overridden per collection by the custom.eyebrow metafield."
    },
    {
      "type": "richtext",
      "id": "intro",
      "label": "Intro text",
      "info": "Used only when the collection has no description of its own."
    },
    {
      "type": "text",
      "id": "image_caption",
      "label": "Image caption"
    },
    {
      "type": "checkbox",
      "id": "show_count_fact",
      "label": "Show the product count as the first fact",
      "default": true
    },
    {
      "type": "text",
      "id": "count_fact_label",
      "label": "Product count label",
      "default": "kilts"
    },
    {
      "type": "text",
      "id": "parent_title",
      "label": "Breadcrumb parent — title",
      "info": "Leave blank for Home / this collection."
    },
    {
      "type": "url",
      "id": "parent_url",
      "label": "Breadcrumb parent — link"
    },
    {
      "type": "link_list",
      "id": "chips_menu",
      "label": "Sub-collection chips",
      "info": "A menu of related collections, shown as round chips under the hero."
    },
    {
      "type": "header",
      "content": "Products"
    },
    {
      "type": "range",
      "id": "products_per_page",
      "label": "Products per page",
      "min": 6,
      "max": 48,
      "step": 3,
      "default": 12
    },
    {
      "type": "text",
      "id": "item_label_one",
      "label": "Item label (one)",
      "default": "kilt"
    },
    {
      "type": "text",
      "id": "item_label_other",
      "label": "Item label (many)",
      "default": "kilts"
    },
    {
      "type": "checkbox",
      "id": "show_sort_by",
