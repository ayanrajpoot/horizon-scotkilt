{%- comment -%}
SK2 FOOTER -- the "add a section" entry point for the SCOTKILT footer.

The markup lives in snippets/sk2-chrome-footer.liquid and
snippets/sk2-chrome-footer-bottom.liquid, which sections/footer.liquid and
sections/footer-utilities.liquid render too. Horizon's footer group does not
accept added sections in the theme editor, so those are the paths that actually
ship; this stays for themes or groups where a section can be added. Menu columns
and social links come from this section's blocks rather than settings.
{%- endcomment -%}

{%- liquid
  assign menu_blocks = section.blocks | where: 'type', 'menu'
  assign social_blocks = section.blocks | where: 'type', 'social'

  for block in menu_blocks limit: 4
    case forloop.index
      when 1
        assign h1 = block.settings.heading
        assign m1 = linklists[block.settings.menu]
      when 2
        assign h2 = block.settings.heading
        assign m2 = linklists[block.settings.menu]
      when 3
        assign h3 = block.settings.heading
        assign m3 = linklists[block.settings.menu]
      when 4
        assign h4 = block.settings.heading
        assign m4 = linklists[block.settings.menu]
    endcase
  endfor

  for block in social_blocks
    case block.settings.network
      when 'instagram'
        assign instagram_url = block.settings.url
      when 'facebook'
        assign facebook_url = block.settings.url
      when 'youtube'
        assign youtube_url = block.settings.url
      when 'tiktok'
        assign tiktok_url = block.settings.url
    endcase
  endfor
-%}

{%- render 'sk2-chrome-footer',
  wordmark: section.settings.wordmark,
  blurb: section.settings.blurb,
  swatch_1: section.settings.swatch_image_1,
  swatch_2: section.settings.swatch_image_2,
  swatch_3: section.settings.swatch_image_3,
  heading_1: h1, menu_1: m1,
  heading_2: h2, menu_2: m2,
  heading_3: h3, menu_3: m3,
  heading_4: h4, menu_4: m4
-%}

{%- render 'sk2-chrome-footer-bottom',
  wordmark: section.settings.wordmark,
  domain: section.settings.domain,
  legal_menu: linklists[section.settings.legal_menu],
  instagram_url: instagram_url,
  facebook_url: facebook_url,
  youtube_url: youtube_url,
  tiktok_url: tiktok_url
-%}

{% stylesheet %}
  .sk2-chrome .footer__swatches img {
    width: 34px;
    height: 34px;
    border-radius: 2px;
    object-fit: cover;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "SK2 Footer",
  "class": "sk2-footer-section",
  "enabled_on": { "groups": ["footer"] },
  "max_blocks": 8,
  "settings": [
    { "type": "header", "content": "Brand column" },
    { "type": "text", "id": "wordmark", "label": "Wordmark", "default": "SCOTKILT" },
    {
      "type": "textarea",
      "id": "blurb",
      "label": "Blurb",
      "default": "A specialist international destination for kilts and the tartans that make them."
    },
    { "type": "text", "id": "domain", "label": "Domain", "default": "scotkilt.com" },
    { "type": "header", "content": "Tartan swatch strip" },
    { "type": "image_picker", "id": "swatch_image_1", "label": "Swatch 1" },
    { "type": "image_picker", "id": "swatch_image_2", "label": "Swatch 2" },
    { "type": "image_picker", "id": "swatch_image_3", "label": "Swatch 3" },
    { "type": "header", "content": "Bottom bar" },
    { "type": "link_list", "id": "legal_menu", "label": "Legal menu", "info": "Privacy, Terms, Shipping, Returns." }
  ],
  "blocks": [
    {
      "type": "menu",
      "name": "Menu column",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading" },
        { "type": "link_list", "id": "menu", "label": "Menu" }
      ]
    },
    {
      "type": "social",
      "name": "Social link",
      "settings": [
        {
          "type": "select",
          "id": "network",
          "label": "Network",
          "default": "instagram",
          "options": [
            { "value": "instagram", "label": "Instagram" },
            { "value": "facebook", "label": "Facebook" },
            { "value": "youtube", "label": "YouTube" },
            { "value": "tiktok", "label": "TikTok" }
          ]
        },
        { "type": "url", "id": "url", "label": "Link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "SK2 Footer",
      "blocks": [
        { "type": "menu", "settings": { "heading": "Shop" } },
        { "type": "menu", "settings": { "heading": "Tartans" } },
        { "type": "menu", "settings": { "heading": "Help" } },
        { "type": "menu", "settings": { "heading": "About" } },
        { "type": "social", "settings": { "network": "instagram" } },
        { "type": "social", "settings": { "network": "facebook" } },
        { "type": "social", "settings": { "network": "youtube" } },
        { "type": "social", "settings": { "network": "tiktok" } }
      ]
    }
  ]
}
{% endschema %}
