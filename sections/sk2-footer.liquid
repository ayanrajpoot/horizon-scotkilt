{%- comment -%}
----------------------------------------------------------------------------------------------------------------------
SK2 FOOTER (SCOTKILT — pages.html `Footer()`)
----------------------------------------------------------------------------------------------------------------------
Ivory-2 footer on a 1.4fr + 4x1fr grid: brand column (wordmark, blurb, tartan
swatch strip) then up to four menu columns, over a bottom bar carrying the
legal links, copyright and circular social icons.

Menu columns come from Admin > Navigation, one link list per block.
{%- endcomment -%}

{{ 'sk2-chrome.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign wordmark = section.settings.wordmark | default: shop.name
  assign menu_blocks = section.blocks | where: 'type', 'menu'
  assign social_blocks = section.blocks | where: 'type', 'social'
-%}

<div class="sk2-chrome">
  <footer class="footer">
    <div class="container">
      <div class="footer__grid">
        <div class="footer__brand">
          <a class="logo" href="{{ routes.root_url }}">{{ wordmark }}</a>

          {%- if section.settings.blurb != blank -%}
            <p>{{ section.settings.blurb }}</p>
          {%- endif -%}

          {%- if section.settings.swatch_image_1 != blank
              or section.settings.swatch_image_2 != blank
              or section.settings.swatch_image_3 != blank
          -%}
            <div class="footer__swatches" aria-hidden="true">
              {%- for i in (1..3) -%}
                {%- assign key = 'swatch_image_' | append: i -%}
                {%- assign swatch_image = section.settings[key] -%}
                {%- if swatch_image != blank -%}
                  {{ swatch_image | image_url: width: 120 | image_tag: loading: 'lazy', alt: '' }}
                {%- endif -%}
              {%- endfor -%}
            </div>
          {%- endif -%}
        </div>

        {%- for block in menu_blocks -%}
          {%- assign menu = linklists[block.settings.menu] -%}
          {%- if menu.links.size > 0 -%}
            <div {{ block.shopify_attributes }}>
              <h4>{{ block.settings.heading | default: menu.title }}</h4>
              <ul>
                {%- for link in menu.links -%}
                  <li><a href="{{ link.url }}">{{ link.title }}</a></li>
                {%- endfor -%}
              </ul>
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>

      <div class="footer__bottom">
        {%- assign legal = linklists[section.settings.legal_menu] -%}
        {%- if legal.links.size > 0 -%}
          <div class="footer__legal">
            {%- for link in legal.links -%}
              <a href="{{ link.url }}">{{ link.title }}</a>
            {%- endfor -%}
          </div>
        {%- endif -%}

        <div>
          &copy; {{ 'now' | date: '%Y' }} {{ wordmark }}
          {%- if section.settings.domain != blank %} · {{ section.settings.domain }}{% endif -%}
        </div>

        {%- if social_blocks.size > 0 -%}
          <div class="social">
            {%- for block in social_blocks -%}
              {%- if block.settings.url != blank -%}
                <a
                  href="{{ block.settings.url }}"
                  aria-label="{{ block.settings.network | capitalize }}"
                  {{ block.shopify_attributes }}
                >
                  {%- render 'sk2-icons', icon: block.settings.network -%}
                </a>
              {%- endif -%}
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>
    </div>
  </footer>
</div>

{% stylesheet %}
  .sk2-chrome .footer__swatches img {
    width: 34px;
    height: 34px;
    border-radius: 2px;
    object-fit: cover;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "SK2 Footer",
  "class": "sk2-footer-section",
  "enabled_on": { "groups": ["footer"] },
  "max_blocks": 8,
  "settings": [
    { "type": "header", "content": "Brand column" },
    { "type": "text", "id": "wordmark", "label": "Wordmark", "default": "SCOTKILT" },
    {
      "type": "textarea",
      "id": "blurb",
      "label": "Blurb",
      "default": "A specialist international destination for kilts and the tartans that make them."
    },
    { "type": "text", "id": "domain", "label": "Domain", "default": "scotkilt.com" },
    { "type": "header", "content": "Tartan swatch strip" },
    { "type": "image_picker", "id": "swatch_image_1", "label": "Swatch 1" },
    { "type": "image_picker", "id": "swatch_image_2", "label": "Swatch 2" },
    { "type": "image_picker", "id": "swatch_image_3", "label": "Swatch 3" },
    { "type": "header", "content": "Bottom bar" },
    { "type": "link_list", "id": "legal_menu", "label": "Legal menu", "info": "Privacy, Terms, Shipping, Returns." }
  ],
  "blocks": [
    {
      "type": "menu",
      "name": "Menu column",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading" },
        { "type": "link_list", "id": "menu", "label": "Menu" }
      ]
    },
    {
      "type": "social",
      "name": "Social link",
      "settings": [
        {
          "type": "select",
          "id": "network",
          "label": "Network",
          "default": "instagram",
          "options": [
            { "value": "instagram", "label": "Instagram" },
            { "value": "facebook", "label": "Facebook" },
            { "value": "youtube", "label": "YouTube" },
            { "value": "tiktok", "label": "TikTok" }
          ]
        },
        { "type": "url", "id": "url", "label": "Link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "SK2 Footer",
      "blocks": [
        { "type": "menu", "settings": { "heading": "Shop" } },
        { "type": "menu", "settings": { "heading": "Tartans" } },
        { "type": "menu", "settings": { "heading": "Help" } },
        { "type": "menu", "settings": { "heading": "About" } },
        { "type": "social", "settings": { "network": "instagram" } },
        { "type": "social", "settings": { "network": "facebook" } },
        { "type": "social", "settings": { "network": "youtube" } },
        { "type": "social", "settings": { "network": "tiktok" } }
      ]
    }
  ]
}
{% endschema %}
