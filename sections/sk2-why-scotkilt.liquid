{%- comment -%}
----------------------------------------------------------------------------------------------------------------------
SK2 WHY SCOTKILT (SCOTKILT — pages.html home v2)
----------------------------------------------------------------------------------------------------------------------
3-column trust feature grid. Matches pages.html `WhyScotkilt()`.
{%- endcomment -%}

{{ 'sk2-home.css' | asset_url | stylesheet_tag }}
<script src="{{ 'sk2-home.js' | asset_url }}" defer></script>

<div class="sk2">
  <section class="sk2__section" aria-labelledby="sk2-why-title-{{ section.id }}">
    <div class="sk2__container">
      <div class="sk2__sec-head sk2-reveal">
        <div>
          <h2 class="h2" id="sk2-why-title-{{ section.id }}">{{ section.settings.heading | escape }}</h2>
          {%- if section.settings.subheading != blank -%}<p class="lede">{{ section.settings.subheading }}</p>{%- endif -%}
        </div>
      </div>
      <div class="sk2-trust">
        {%- for block in section.blocks -%}
          {%- if block.type == 'feature' -%}
            <div class="sk2-tf" {{ block.shopify_attributes }}>
              {%- render 'sk2-icons', icon: block.settings.icon -%}
              <div>
                <h3>{{ block.settings.title | escape }}</h3>
                {%- if block.settings.text != blank -%}<p>{{ block.settings.text }}</p>{%- endif -%}
              </div>
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>
  </section>
</div>

{% schema %}
{
  "name": "SK2 Why SCOTKILT",
  "class": "shopify-section--sk2-why-scotkilt",
  "tag": "section",
  "max_blocks": 6,
  "settings": [
    {
      "type": "paragraph",
      "content": "Home v2 (pages.html design). 3-column trust feature grid."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Why SCOTKILT?"
    },
    {
      "type": "richtext",
      "id": "subheading",
      "label": "Subheading",
      "default": "<p>A specialist store, built around the two things that matter: the kilt and the cloth.</p>"
    }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "default": "weave",
          "options": [
            { "value": "weave", "label": "Weave" },
            { "value": "styles", "label": "Styles" },
            { "value": "measure", "label": "Measure" },
            { "value": "balance", "label": "Balance" },
            { "value": "support", "label": "Support" },
            { "value": "globe", "label": "Globe" }
          ]
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Premium tartan selection"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "A curated range of clan, universal and fashion tartans, chosen for how they look in pleats."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "SK2 Why SCOTKILT",
      "blocks": [
        { "type": "feature", "settings": { "icon": "weave", "title": "Premium tartan selection", "text": "A curated range of clan, universal and fashion tartans, chosen for how they look in pleats." } },
        { "type": "feature", "settings": { "icon": "styles", "title": "Multiple kilt styles", "text": "Tartan, utility, leather, hybrid, contemporary and traditional — one place for every kilt." } },
        { "type": "feature", "settings": { "icon": "measure", "title": "Easy size guidance", "text": "Three measuring steps and a clear size guide so the fit is right the first time." } },
        { "type": "feature", "settings": { "icon": "balance", "title": "Modern and traditional options", "text": "From full ceremonial pleating to kilts made for jeans-and-boots weekends." } },
        { "type": "feature", "settings": { "icon": "support", "title": "Customer support", "text": "Questions about a tartan, a size or an order — a real person replies." } },
        { "type": "feature", "settings": { "icon": "globe", "title": "International ecommerce experience", "text": "Built for customers ordering from around the world, with clear pricing at checkout." } }
      ]
    }
  ]
}
{% endschema %}
