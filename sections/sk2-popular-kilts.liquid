{%- comment -%}
----------------------------------------------------------------------------------------------------------------------
SK2 POPULAR KILTS (SCOTKILT — pages.html home v2)
----------------------------------------------------------------------------------------------------------------------
Horizontal rail of real product cards. Matches pages.html `PopularKilts()`. Each block references a product.
{%- endcomment -%}

{{ 'sk2-home.css' | asset_url | stylesheet_tag }}
<script src="{{ 'sk2-home.js' | asset_url }}" defer></script>

{%- liquid
  assign rail_id = 'sk2-rail-products-' | append: section.id
-%}

<div class="sk2">
  <section class="sk2__section" aria-labelledby="sk2-popular-title-{{ section.id }}">
    <div class="sk2__container">
      <div class="sk2__sec-head sk2-reveal">
        <div>
          <h2 class="h2" id="sk2-popular-title-{{ section.id }}">{{ section.settings.heading | escape }}</h2>
          {%- if section.settings.subheading != blank -%}<p class="lede">{{ section.settings.subheading }}</p>{%- endif -%}
        </div>
        <div class="sk2__sec-head__tools">
          {%- if section.settings.link_text != blank -%}
            <a class="sk2__link" href="{{ section.settings.link_url | default: '#' }}">{{ section.settings.link_text | escape }}</a>
          {%- endif -%}
          <div class="sk2-rail-btns">
            <button type="button" class="sk2-rail-btn" data-sk2-rail-btn="{{ rail_id }}" data-sk2-dir="prev" aria-label="Previous">{% render 'sk2-icons', icon: 'left' %}</button>
            <button type="button" class="sk2-rail-btn" data-sk2-rail-btn="{{ rail_id }}" data-sk2-dir="next" aria-label="Next">{% render 'sk2-icons', icon: 'right' %}</button>
          </div>
        </div>
      </div>
    </div>
    <div class="sk2-rail-wrap">
      <div class="sk2-rail" id="{{ rail_id }}">
        {%- for block in section.blocks -%}
          {%- if block.type == 'product' and block.settings.product != blank -%}
            {%- assign product = block.settings.product -%}
            <article class="sk2-pcard" {{ block.shopify_attributes }}>
              <div class="sk2-pcard__media">
                <a href="{{ product.url }}" aria-label="{{ product.title | escape }}">
                  {%- render 'sk2-visual',
                    image: product.featured_image,
                    alt: product.title,
                    color_1: '#3d3a35', color_2: '#2b2925', color_3: '#171614',
                    ratio: '4/5', class: 'sk2-visual--zoom'
                  -%}
                </a>
                {%- if block.settings.badge != blank -%}
                  <div class="sk2-pcard__badges"><span class="badge badge--ink">{{ block.settings.badge | escape }}</span></div>
                {%- endif -%}
              </div>
              <div class="sk2-pcard__body">
                {%- if block.settings.style_note != blank -%}<div class="sk2-pcard__style">{{ block.settings.style_note | escape }}</div>{%- endif -%}
                <h3><a href="{{ product.url }}">{{ product.title | escape }}</a></h3>
                <div class="sk2-pcard__rating">
                  {%- if block.settings.rating > 0 -%}
                    {%- render 'sk2-stars', rating: block.settings.rating -%}<span>{{ block.settings.rating }} ({{ block.settings.review_count }})</span>
                  {%- else -%}
                    {%- render 'sk2-stars' -%}<span>No reviews yet</span>
                  {%- endif -%}
                </div>
                <div class="sk2-price">
                  {{ product.price | money }}
                  {%- if product.compare_at_price > product.price -%}<s>{{ product.compare_at_price | money }}</s>{%- endif -%}
                </div>
                <div class="sk2-pcard__add">
                  {%- form 'product', product -%}
                    <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
                    <button type="submit" class="btn btn--line" {% if product.selected_or_first_available_variant.available == false %}disabled{% endif %}>
                      {%- if product.selected_or_first_available_variant.available == false -%}Sold out{%- else -%}Add to cart{%- endif -%}
                    </button>
                  {%- endform -%}
                </div>
              </div>
            </article>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>
  </section>
</div>

{% schema %}
{
  "name": "SK2 Popular kilts",
  "class": "shopify-section--sk2-popular-kilts",
  "tag": "section",
  "max_blocks": 12,
  "settings": [
    {
      "type": "paragraph",
      "content": "Home v2 (pages.html design). A horizontal rail of real products. Pick products in each block."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Popular Kilts"
    },
    {
      "type": "richtext",
      "id": "subheading",
      "label": "Subheading",
      "default": "<p>Our best sellers, trending styles and new arrivals.</p>"
    },
    {
      "type": "text",
      "id": "link_text",
      "label": "Link text",
      "default": "Shop all kilts"
    },
    {
      "type": "url",
      "id": "link_url",
      "label": "Link"
    }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Product",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Product"
        },
        {
          "type": "text",
          "id": "style_note",
          "label": "Style note (optional)",
          "info": "Shown above the title, e.g. tartan name and weight."
        },
        {
          "type": "text",
          "id": "badge",
          "label": "Badge (optional)",
          "info": "e.g. Best Seller, Trending, New"
        },
        {
          "type": "range",
          "id": "rating",
          "label": "Rating",
          "min": 0,
          "max": 5,
          "step": 0.5,
          "default": 0
        },
        {
          "type": "number",
          "id": "review_count",
          "label": "Review count",
          "default": 0
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "SK2 Popular kilts"
    }
  ]
}
{% endschema %}
