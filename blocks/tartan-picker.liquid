{% doc %}
  Tartan picker — Horizon theme block wrapper.

  Ported from Prestige, where the picker was a `tartan_picker` case in
  `sections/main-product.liquid` + `snippets/product-info.liquid`. Horizon uses
  theme blocks instead, so the same settings live here and the block is
  automatically offered anywhere `@theme` blocks are accepted — including quick
  add — with no edit to `sections/product-information.liquid`.

  `snippets/tartan-picker.liquid` is byte-identical to the source and does all
  the work; this file only supplies `product` and `form_id`.
{% enddoc %}

{% liquid
  assign product_resource = closest.product
  if request.visual_preview_mode and product_resource == blank
    assign product_resource = collections.all.products.first
  endif

  # Matches the form id built in blocks/buy-buttons.liquid.
  assign product_form_id = 'BuyButtons-ProductForm-' | append: section.id
%}

{% unless product_resource == blank %}
  {% render 'xx-tartan-theme-vars' %}
  {% render 'tartan-picker',
    product: product_resource,
    block: block,
    form_id: product_form_id
  %}
{% endunless %}

