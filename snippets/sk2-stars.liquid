{%- comment -%}
  SK2 STARS — accepts `rating` (0-5, blank for none). {% render 'sk2-stars', rating: 4.5 %}
{%- endcomment -%}
<span class="sk2-stars" aria-hidden="true">
  {%- for i in (1..5) -%}
    {%- assign on = false -%}
    {%- if rating and i <= rating -%}{%- assign on = true -%}{%- endif -%}
    <svg class="{% if on %}on{% endif %}" viewBox="0 0 24 24"><path d="M12 3.5l2.6 5.5 6 .7-4.4 4.1 1.2 5.9L12 16.8l-5.4 2.9 1.2-5.9L3.4 9.7l6-.7z"/></svg>
  {%- endfor -%}
</span>
