{%- doc -%}
  SCOTKILT header — pages.html `Header()`, `MegaMenu()`, `MobileNav()`.

  Sticky ivory bar, 72px, three-column grid: burger / logo / nav, tools right. A
  top-level menu item with children opens a full-width mega panel. The panel is a
  child of `.nav__item`, which sk2-chrome.css keeps `position: static` so it
  resolves against `.header` and spans the viewport — do not make `.nav__item`
  relative.

  Columns are the menu's second level, links its third; a two-level menu renders
  one column per child. The cart count and cart opening are delegated to
  Horizon's own drawer rather than reimplemented.

  Rendered by `sections/header.liquid` (the section the store's header group
  already carries) and by `sections/sk2-header.liquid`.

  @param {object} menu - a linklist
  @param {string} wordmark - text logo, used when no image is set
  @param {string} [tagline] - brass sub-wordmark, hidden below 1024px
  @param {object} [logo] - image that replaces the wordmark
  @param {string} [search_placeholder]
  @param {string} [search_hints] - richtext under the search field
  @param {object} [feature_blocks] - the section's blocks, of which those typed
    `feature` render a mega-menu feature card. Omitted by the native header
    section, which has no block type that can hold one.
  @param {string} [sticky] - 'always', 'scroll-up' (hides going down, returns
    coming up) or blank for a header that scrolls away
  @param {boolean} [transparent] - lay the bar over the first section
  @param {string} [transparent_text] - text colour while transparent
  @param {object} [transparent_logo] - logo image used while transparent
  @param {boolean} [show_country] - country/region selector
  @param {boolean} [show_language] - language selector
  @param {boolean} [predictive_search] - open Horizon's predictive search dialog
    instead of the pages.html overlay
  @param {number} [logo_width] - logo image cap, px
  @param {number} [logo_mobile_width]
  @param {number} [border_width] - bottom separation border, px
  @param {string} [border_color]
  @param {string} [menu_trigger] - 'hover' (default) or 'click'
  @param {string} [form_id] - unique id for the localization forms
{%- enddoc -%}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,500;0,600;1,500&family=Manrope:wght@400;500;600;700&display=swap" rel="stylesheet">
{{ 'sk2-chrome.css' | asset_url | stylesheet_tag }}
{{ 'sk2-horizon-bridge.css' | asset_url | stylesheet_tag }}
<script src="{{ 'sk2-chrome.js' | asset_url }}" defer></script>

{%- liquid
  assign sk_wordmark = wordmark | default: shop.name
  assign sk_localize = false
  if show_country or show_language
    assign sk_localize = true
  endif
  assign sk_form_id = form_id | default: 'sk2-header'
  assign sk_form_id_drawer = sk_form_id | append: '-drawer'

  comment
    Transparent mode swaps the logo and repaints the bar through one custom
    property, so the colour scheme stays the single source of truth elsewhere.
  endcomment
  assign sk_logo_image = logo
  if transparent and transparent_logo != blank
    assign sk_logo_image = transparent_logo
  endif

  capture sk_header_style
    if logo_width != blank
      echo '--sk2-logo-w:' | append: logo_width | append: 'px;'
    endif
    if logo_mobile_width != blank
      echo '--sk2-logo-w-m:' | append: logo_mobile_width | append: 'px;'
    endif
    if border_width != blank
      echo '--sk2-header-border:' | append: border_width | append: 'px;'
    endif
    if border_color != blank
      echo '--sk2-header-border-color:' | append: border_color | append: ';'
    endif
    if transparent and transparent_text != blank
      echo '--sk2-header-on:' | append: transparent_text | append: ';'
    endif
  endcapture
-%}

{%- capture sk_logo -%}
  <a class="logo" href="{{ routes.root_url }}" aria-label="{{ sk_wordmark | escape }} home">
    {%- if sk_logo_image != blank -%}
      {{ sk_logo_image | image_url: width: 600 | image_tag: loading: 'eager', alt: sk_wordmark }}
    {%- else -%}
      {{- sk_wordmark -}}
      {%- if tagline != blank -%}
        <small>{{ tagline }}</small>
      {%- endif -%}
    {%- endif -%}
  </a>
{%- endcapture -%}

<div class="sk2-chrome" data-sk2-chrome>
  <header
    class="header{% if transparent %} header--transparent{% endif %}"
    id="sk2-header"
    data-sk2-sticky="{{ sticky | default: 'always' }}"
    data-sk2-trigger="{{ menu_trigger | default: 'hover' }}"
    {% if sk_header_style != blank %}style="{{ sk_header_style }}"{% endif %}
  >
    <div class="container header__bar">
      <button
        class="ibtn burger"
        data-sk2-action="nav-open"
        data-sk2-nav-open
        aria-label="{{ 'accessibility.menu' | t }}"
        aria-controls="sk2-mnav"
        aria-expanded="false"
      >
        {%- render 'sk2-icons', icon: 'menu' -%}
      </button>

      {{ sk_logo }}

      <nav class="nav" aria-label="{{ 'accessibility.header_navigation_label' | t }}">
        {%- for link in menu.links -%}
          <div class="nav__item">
            <a
              class="nav__link"
              href="{{ link.url }}"
              {% if link.links.size > 0 %}
                aria-haspopup="true" aria-expanded="false"
              {% endif %}
            >
              {{- link.title -}}
            </a>

            {%- if link.links.size > 0 -%}
              <div class="mega" role="region" aria-label="{{ link.title | escape }} menu">
                <div class="mega__inner">
                  {%- for child in link.links -%}
                    <div class="mega__col">
                      <h4>{{ child.title }}</h4>
                      <ul>
                        {%- if child.links.size > 0 -%}
                          {%- for grandchild in child.links -%}
                            <li><a href="{{ grandchild.url }}">{{ grandchild.title }}</a></li>
                          {%- endfor -%}
                        {%- else -%}
                          <li><a href="{{ child.url }}">{{ child.title }}</a></li>
                        {%- endif -%}
                      </ul>
                    </div>
                  {%- endfor -%}

                  {%- for block in feature_blocks -%}
                    {%- if block.type == 'feature' and block.settings.menu_item == link.title -%}
                      <a class="mega__feat" href="{{ block.settings.link }}" {{ block.shopify_attributes }}>
                        {%- render 'sk2-visual',
                          image: block.settings.image,
                          alt: block.settings.title,
                          ratio: '4/3'
                        -%}
                        <p>
                          {{- block.settings.label -}}
                          <strong>{{ block.settings.title }}</strong>
                        </p>
                      </a>
                    {%- endif -%}
                  {%- endfor -%}
                </div>
              </div>
            {%- endif -%}
          </div>
        {%- endfor -%}
      </nav>

      <div class="header__tools">
        {%- comment -%}
          Predictive mode hands the click to `snippets/search-modal.liquid`,
          which layout/theme.liquid already renders on every page -- no second
          search implementation to keep in step.
        {%- endcomment -%}
        {%- if predictive_search -%}
          <button class="ibtn" on:click="#search-modal/showDialog" aria-label="{{ 'content.search' | t }}">
            {%- render 'sk2-icons', icon: 'search' -%}
          </button>
        {%- else -%}
          <button
            class="ibtn"
            data-sk2-action="search-toggle"
            data-sk2-search-toggle
            aria-label="Search"
            aria-expanded="false"
          >
            {%- render 'sk2-icons', icon: 'search' -%}
          </button>
        {%- endif -%}

        {%- if sk_localize -%}
          <div class="header__localize header--desktop-only">
            {%- render 'localization-form',
              show_country: show_country,
              show_language: show_language,
              localization_style: 'dropdown',
              form_id: sk_form_id
            -%}
          </div>
        {%- endif -%}

        {%- if shop.customer_accounts_enabled -%}
          <a
            class="ibtn ibtn--desk"
            href="{{ routes.account_url }}"
            aria-label="{{ 'accessibility.account' | t }}"
          >
            {%- render 'sk2-icons', icon: 'user' -%}
          </a>
        {%- endif -%}

        {%- comment -%}
          Cart: Horizon's own drawer, opened exactly as snippets/header-actions.liquid
          does, so its focus handling and live count keep working. Falls back to the
          cart page when the drawer is off or we are already on it.
        {%- endcomment -%}
        {%- if settings.cart_type == 'drawer' and template.name != 'cart' -%}
          <button
            class="ibtn"
            on:click="#cart-drawer/toggle"
            aria-haspopup="dialog"
            aria-expanded="false"
            aria-controls="cart-drawer"
            aria-label="{{ 'accessibility.cart' | t }}"
          >
            {%- render 'sk2-icons', icon: 'bag' -%}
            {%- render 'cart-bubble' -%}
          </button>
        {%- else -%}
          <a class="ibtn" href="{{ routes.cart_url }}" aria-label="{{ 'accessibility.cart' | t }}">
            {%- render 'sk2-icons', icon: 'bag' -%}
            {%- render 'cart-bubble' -%}
          </a>
        {%- endif -%}
      </div>
    </div>

    {%- comment -%}Search overlay — full width, anchored to the header.{%- endcomment -%}
    <div class="search" data-sk2-search>
      <div class="container search__inner">
        <form class="search__field" action="{{ routes.search_url }}" method="get" role="search">
          {%- render 'sk2-icons', icon: 'search' -%}
          <input
            type="search"
            name="q"
            placeholder="{{ search_placeholder }}"
            aria-label="{{ search_placeholder }}"
            autocomplete="off"
          >
          <button
            type="button"
            class="ibtn"
            data-sk2-action="search-close"
            aria-label="Close"
          >
            {%- render 'sk2-icons', icon: 'close' -%}
          </button>
        </form>

        {%- if search_hints != blank -%}
          <div class="search__hint">{{ search_hints }}</div>
        {%- endif -%}
      </div>
    </div>
  </header>

  {%- comment -%}Mobile drawer.{%- endcomment -%}
  <div class="drawer-backdrop" data-sk2-backdrop data-sk2-action="close-all"></div>

  <aside class="mnav" id="sk2-mnav" aria-label="{{ 'accessibility.menu' | t }}" aria-hidden="true" data-sk2-mnav>
    <div class="mnav__head">
      {{ sk_logo }}
      <button class="ibtn" data-sk2-action="close-all" aria-label="Close">
        {%- render 'sk2-icons', icon: 'close' -%}
      </button>
    </div>

    <div class="mnav__body">
      {%- for link in menu.links -%}
        {%- if link.links.size > 0 -%}
          <div class="macc">
            <button class="macc__btn" data-sk2-action="macc" aria-expanded="false">
              {{- link.title -}}
              {%- render 'sk2-icons', icon: 'chevron' -%}
            </button>
            <div class="macc__panel">
              <div>
                <ul>
                  {%- for child in link.links -%}
                    {%- if child.links.size > 0 -%}
                      {%- if link.links.size > 1 -%}<h5>{{ child.title }}</h5>{%- endif -%}
                      {%- for grandchild in child.links -%}
                        <li><a href="{{ grandchild.url }}">{{ grandchild.title }}</a></li>
                      {%- endfor -%}
                    {%- else -%}
                      <li><a href="{{ child.url }}">{{ child.title }}</a></li>
                    {%- endif -%}
                  {%- endfor -%}
                </ul>
              </div>
            </div>
          </div>
        {%- else -%}
          <a class="macc__btn" href="{{ link.url }}">{{ link.title }}</a>
        {%- endif -%}
      {%- endfor -%}
    </div>

    {%- if shop.customer_accounts_enabled or sk_localize -%}
      <div class="mnav__foot">
        {%- if shop.customer_accounts_enabled -%}
          <a href="{{ routes.account_url }}">
            {%- render 'sk2-icons', icon: 'user' -%}
            {{- 'accessibility.account' | t -}}
          </a>
        {%- endif -%}
        {%- if sk_localize -%}
          <div class="header__localize">
            {%- render 'localization-form',
              show_country: show_country,
              show_language: show_language,
              localization_style: 'dropdown',
              form_id: sk_form_id_drawer
            -%}
          </div>
        {%- endif -%}
      </div>
    {%- endif -%}
  </aside>
</div>

